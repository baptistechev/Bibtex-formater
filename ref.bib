	title = {Application of quantum annealing to compressive sensing},
	abstract = {In this paper, we discuss compressed sensing [1] [2], which is attracting attention as an efficient data acquisition method, and annealing methods [3] [4], which are increasingly being used as an approximate solution method for combinatorial optimization problems. In recent years, the amount of data generated worldwide has been rapidly increasing. From the perspective of acquiring information, the amount of data measured per unit time using a single device is increasing due to the improvement of the performance of information acquisition devices such as cameras [5]. As a result, the increase in information obtained from satellites and sensor networks has become a problem in various fields [6]. For example, there is a problem that the communication throughput is low compared to the amount of data acquired in high-resolution surveillance systems [5]. As a method to solve such problems, compressed sensing takes the approach of reducing the amount of data acquired in the first place. Another problem is how to infer unobserved states from limited observed values. For example, there is the problem of identifying the performance bottleneck of a large-scale computer system. The larger the system, the more unrealistic it is in terms of cost and time to constantly check all components. Therefore, when a problem occurs in a system, instead of thoroughly inspecting all components, it is possible to divide the whole into several parts and perform some measurement to identify the problematic part using the small amount of data obtained (compared to inspecting all components). The problem with compressed sensing is how to restore the original (large) information from the small amount of data acquired, and various restoration algorithms have been devised.
In this paper, we focus on a group of algorithms called greedy algorithms among the many algorithms available, and attempt to reduce the time complexity of the algorithm by applying annealing to these. Chapter 1 briefly explains compressed sensing and quantum annealing, which are the subject of this paper. First, we describe the overview, applications, and problems of compressed sensing. After that, we provide an overview of combinatorial optimization problems, and an overview of annealing, which is an approximate solution method for combinatorial optimization problems, divided into classical annealing and quantum annealing.},
	language = {Japanese},
	urldate = {2025-04-22},
	school = {Keio University},
	author = {Yamaguchi, Shinpei},
	year = {2024},
}

@article{chevalier_compressed_2024,
	title = {Compressed sensing enhanced by a quantum approximate optimization algorithm},
	volume = {110},
	url = {https://link.aps.org/doi/10.1103/PhysRevA.110.062410},
	doi = {10.1103/PhysRevA.110.062410},
	abstract = {We present a framework to deal with a range of large-scale compressive-sensing problems using a quantum subroutine. We apply a quantum approximate optimization algorithm (QAOA) to support detection in a sparse-signal reconstruction algorithm: matching pursuit. The constrained optimization required in this algorithm is difficult to handle when the size of the problem is large, and the constraints usually given by unstructured patterns also become an issue. Our framework utilizes specially designed structured constraints that are easy to manipulate and reduce the optimization problem to the solution of an Ising model which can be found using Ising solvers. In this study, we simulate QAOA for this purpose and evaluate the performances. We observe that our method can outperform reference classical methods in the same context. Our results explore a promising path for applying quantum computers in the compressive-sensing field.},
	number = {6},
	urldate = {2025-04-22},
